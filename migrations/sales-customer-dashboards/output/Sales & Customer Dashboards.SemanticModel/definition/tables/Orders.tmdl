	measure '% Diff Sales per Customers' = DIVIDE(([CY Sales per Customer] - [PY Sales per Customer]), [PY Sales per Customer])
		formatString: 0.0%;-0.0%;-
		displayFolder: Tableau calcs
		lineageTag: 8fc604a5-2230-562f-b25d-4d229f526ab3

	measure 'CY Sales per Customer' = DIVIDE(SUMX('Orders', IF((YEAR('Orders'[Order Date]) = SELECTEDVALUE('Select Year'[Select Year], 2023)), 'Orders'[Sales])), COUNTROWS(FILTER(DISTINCT(SELECTCOLUMNS('Orders', "__v", IF((YEAR('Orders'[Order Date]) = SELECTEDVALUE('Select Year'[Select Year], 2023)), 'Orders'[Customer ID]))), NOT ISBLANK([__v]))))
		formatString: "$"#,##0;-"$"#,##0
		displayFolder: Tableau calcs
		lineageTag: 4e849ab1-f223-5053-a0d7-3073e1fb258d

	measure 'PY Sales per Customer' = DIVIDE(SUMX('Orders', IF((YEAR('Orders'[Order Date]) = (SELECTEDVALUE('Select Year'[Select Year], 2023) - 1)), 'Orders'[Sales])), COUNTROWS(FILTER(DISTINCT(SELECTCOLUMNS('Orders', "__v", IF((YEAR('Orders'[Order Date]) = (SELECTEDVALUE('Select Year'[Select Year], 2023) - 1)), 'Orders'[Customer ID]))), NOT ISBLANK([__v]))))
