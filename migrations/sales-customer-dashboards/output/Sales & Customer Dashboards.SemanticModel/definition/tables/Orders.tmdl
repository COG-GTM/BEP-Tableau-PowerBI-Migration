	measure 'KPI CY Less PY' = IF((SUMX('Orders', IF((YEAR('Orders'[Order Date]) = SELECTEDVALUE('Select Year'[Select Year], 2023)), 'Orders'[Sales])) < SUMX('Orders', IF((YEAR('Orders'[Order Date]) = (SELECTEDVALUE('Select Year'[Select Year], 2023) - 1)), 'Orders'[Sales]))), "⬤", "")
		displayFolder: Tableau calcs
		lineageTag: 36514fb1-3e18-5cd1-99c5-0d826b3aa91c

