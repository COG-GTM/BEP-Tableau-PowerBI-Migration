		lineageTag: 62b19d16-c189-527c-959f-d07a13b35105
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Termdate (Year)' = YEAR('HumanResources'[Termdate])
		dataType: int64
		formatString: 0
		lineageTag: ae894291-b5b4-58f0-8be2-a2e444edf06b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	measure '% Total Terminated' = DIVIDE([Total Terminated], CALCULATE([Total Terminated], ALLSELECTED()))
		formatString: 0.0%;-0.0%;-
		displayFolder: Tableau calcs
		lineageTag: 2d7b0b43-5b1a-5603-9c67-20185d938fd6

	measure '% Total Hired' = DIVIDE([Total Hired], CALCULATE([Total Hired], ALLSELECTED()))
		formatString: 0.0%;-0.0%;-
		displayFolder: Tableau calcs
		lineageTag: 0fc1c9b0-0c0c-5293-a01f-2000d12c8191

	measure 'Total Hired' = COUNT('HumanResources'[Employee_ID])
		formatString: #,##0
		displayFolder: Tableau calcs
		lineageTag: 52da1e14-8a8d-58b3-b62b-c50b148eb2c7

	measure 'Total Terminated' = COUNTX('HumanResources', IF(NOT(ISBLANK('HumanResources'[Termdate])), 'HumanResources'[Employee_ID]))
		formatString: #,##0
		displayFolder: Tableau calcs
		lineageTag: e84750a5-d923-5551-8443-5d97836963a7

	measure 'Total Active' = COUNTX('HumanResources', IF(ISBLANK('HumanResources'[Termdate]), 'HumanResources'[Employee_ID]))
		formatString: #,##0
		displayFolder: Tableau calcs
		lineageTag: 3b7a8287-b263-57e8-a3db-7f05c45e2802

	measure 'AVG Salary' = AVERAGE('HumanResources'[Salary])
		formatString: #,##0.00
		displayFolder: Auto measures
		lineageTag: 6af9d32d-af5c-5f1b-aa0d-f8af856ff336

	measure 'AVG Age' = AVERAGE('HumanResources'[Age])
		formatString: #,##0.00
		displayFolder: Auto measures
		lineageTag: c5ceb68d-ae82-5332-aa08-fb75af4b6a95

	measure 'Length of Hire' = SUM('HumanResources'[Length of Hire])
		formatString: #,##0.00
		displayFolder: Auto measures
		lineageTag: fd7ce1fd-b6d9-5160-aded-0e030c42fc26

	measure Age = SUM('HumanResources'[Age])
		formatString: #,##0.00
		displayFolder: Auto measures
		lineageTag: 63b7f14e-95cb-50e0-96d5-90934599ab89

	measure Salary = SUM('HumanResources'[Salary])
		formatString: #,##0.00
		displayFolder: Auto measures
		lineageTag: 24fc1e67-d661-5eb9-881d-6f3771183323

	partition HumanResources = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\HumanResources.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    PromoteHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    ChangedType = Table.TransformColumnTypes(PromoteHeaders, {{"Employee_ID", type text}, {"First Name", type text}, {"Last Name", type text}, {"Gender", type text}, {"State", type text}, {"City", type text}, {"Education Level", type text}, {"Birthdate", type date}, {"Hiredate", type date}, {"Termdate", type date}, {"Department", type text}, {"Job Title", type text}, {"Salary", Int64.Type}, {"Performance Rating", type text}}, "en-US")
				in
				    ChangedType
