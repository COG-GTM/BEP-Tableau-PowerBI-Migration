model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Orders", "Customers", "Products", "Location", "Select Year", "Orders per Customer", "Measures"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table Orders
ref table Customers
ref table Products
ref table Location
ref table 'Select Year'
ref table 'Orders per Customer'
ref table Measures
