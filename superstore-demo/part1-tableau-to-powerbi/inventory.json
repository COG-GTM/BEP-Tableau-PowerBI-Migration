  "calculated_fields": [
    {
      "name": "% Diff Orders",
      "datatype": "real",
      "role": "measure",
      "formula": "(COUNTD([CY Orders]) - COUNTD([PY Orders])) / COUNTD([PY Orders])"
    },
    {
      "name": "% Diff Customers",
      "datatype": "real",
      "role": "measure",
      "formula": "(COUNTD([CY Customers]) - COUNTD([PY Customers])) / COUNTD([PY Customers])"
    },
    {
      "name": "% Diff Quantity",
      "datatype": "real",
      "role": "measure",
      "formula": "(SUM([CY Quantity]) - SUM([PY Quantity])) / SUM([PY Quantity])"
    },
    {
      "name": "% Diff Profit",
      "datatype": "real",
      "role": "measure",
      "formula": "(SUM([CY Profit]) - SUM([PY Profit])) / SUM([CY Profit])"
    },
    {
      "name": "% Diff Sales per Customers",
      "datatype": "real",
      "role": "measure",
      "formula": "([CY Sales per Customer] - [PY Sales per Customer]) / [PY Sales per Customer]"
    },
    {
      "name": "PY Customers",
      "datatype": "string",
      "role": "dimension",
      "formula": "IF YEAR([Order Date])= [Parameters].[Select Year]-1 THEN [Customer ID] \r\nEND"
    },
    {
      "name": "CY Sales per Customer",
      "datatype": "real",
      "role": "measure",
      "formula": "SUM([CY Sales]) / COUNTD([CY Customers])"
    },
    {
      "name": "CY Quantity",
      "datatype": "integer",
      "role": "measure",
      "formula": "IF YEAR([Order Date]) = [Parameters].[Select Year] THEN [Quantity]\r\nEND"
    },
    {
      "name": "CY Profit",
      "datatype": "real",
      "role": "measure",
      "formula": "IF YEAR([Order Date]) = [Parameters].[Select Year] THEN [Profit]\r\nEND"
    },
    {
      "name": "CY Customers",
      "datatype": "string",
      "role": "dimension",
      "formula": "IF YEAR([Order Date])= [Parameters].[Select Year] THEN [Customer ID] \r\nEND"
    },
    {
      "name": "CY Orders",
      "datatype": "string",
      "role": "dimension",
      "formula": "IF YEAR([Order Date]) = [Parameters].[Select Year] THEN [Order ID]\r\nEND"
    },
    {
      "name": "PY Sales",
      "datatype": "real",
      "role": "measure",
      "formula": "IF YEAR([Order Date]) = [Parameters].[Select Year]-1 THEN [Sales]\r\nEND"
    },
    {
      "name": "PY Sales per Customer",
      "datatype": "real",
      "role": "measure",
      "formula": "SUM([PY Sales]) / COUNTD([PY Customers])"
    },
    {
      "name": "Current Year",
      "datatype": "integer",
      "role": "dimension",
      "formula": "[Parameters].[Select Year]"
    },
    {
      "name": "Previous Year",
      "datatype": "integer",
      "role": "dimension",
      "formula": "[Parameters].[Select Year]-1"
    },
    {
      "name": "KPI CY Less PY",
      "datatype": "string",
      "role": "measure",
      "formula": "IF SUM([CY Sales]) < SUM([PY Sales]) THEN '\u2b24'\r\nELSE ''\r\nEND"
    },
    {
      "name": "KPI Sales Avg",
      "datatype": "string",
      "role": "measure",
      "formula": "IF SUM([CY Sales]) > WINDOW_AVG(SUM([CY Sales]))\r\nTHEN 'Above'\r\nELSE 'Below'\r\nEND"
    },
    {
      "name": "CY Sales",
      "datatype": "real",
      "role": "measure",
      "formula": "IF YEAR([Order Date]) = [Parameters].[Select Year] THEN [Sales]\r\nEND"
    },
    {
      "name": "Order Date (Year)",
      "datatype": "integer",
      "role": "measure",
      "formula": "YEAR([Order Date])"
    },
    {
      "name": "% Diff Sales",
      "datatype": "real",
      "role": "measure",
      "formula": "(SUM([CY Sales]) - SUM([PY Sales])) / SUM([PY Sales])"
    },
    {
      "name": "Min/Max Sales",
      "datatype": "real",
      "role": "measure",
      "formula": "IF SUM([CY Sales]) = WINDOW_MAX(SUM([CY Sales]))\r\nTHEN SUM([CY Sales])\r\nELSEIF SUM([CY Sales]) = WINDOW_MIN(SUM([CY Sales]))\r\nTHEN SUM([CY Sales])\r\nEND"
    },
    {
      "name": "{SUM([CY Sales])}",
      "datatype": "real",
      "role": "measure",
      "formula": "{SUM([CY Sales])}"
    },
    {
      "name": "Nr of Orders per Customers",
      "datatype": "integer",
      "role": "dimension",
      "formula": "{ FIXED [CY Customers]: COUNTD([CY Orders])}"
    },
    {
      "name": "KPI Profit Avg",
      "datatype": "string",
      "role": "measure",
      "formula": "IF SUM([CY Profit]) > WINDOW_AVG(SUM([CY Profit]))\r\nTHEN 'Above'\r\nELSE 'Below'\r\nEND"
    },
    {
      "name": "Min/Max Sales Per Customers",
      "datatype": "real",
      "role": "measure",
      "formula": "IF [CY Sales per Customer] = WINDOW_MAX([CY Sales per Customer])\r\nTHEN [CY Sales per Customer] \r\nELSEIF [CY Sales per Customer] = WINDOW_MIN([CY Sales per Customer])\r\nTHEN [CY Sales per Customer]\r\nEND"
    },
    {
      "name": "Min/Max Customers",
      "datatype": "integer",
      "role": "measure",
      "formula": "IF COUNTD([CY Customers]) = WINDOW_MAX(COUNTD([CY Customers]))\r\nTHEN COUNTD([CY Customers])\r\nELSEIF COUNTD([CY Customers]) = WINDOW_MIN(COUNTD([CY Customers]))\r\nTHEN COUNTD([CY Customers])\r\nEND"
    },
    {
      "name": "Min/Max Quantity",
      "datatype": "integer",
      "role": "measure",
      "formula": "IF SUM([CY Quantity]) = WINDOW_MAX(SUM([CY Quantity]))\r\nTHEN SUM([CY Quantity])\r\nELSEIF SUM([CY Quantity]) = WINDOW_MIN(SUM([CY Quantity]))\r\nTHEN SUM([CY Quantity])\r\nEND"
    },
    {
      "name": "Min/Max Profit",
      "datatype": "real",
      "role": "measure",
      "formula": "IF SUM([CY Profit]) = WINDOW_MAX(SUM([CY Profit]))\r\nTHEN SUM([CY Profit])\r\nELSEIF SUM([CY Profit]) = WINDOW_MIN(SUM([CY Profit]))\r\nTHEN SUM([CY Profit])\r\nEND"
    },
    {
      "name": "Min/Max Orders",
      "datatype": "integer",
      "role": "measure",
      "formula": "IF COUNTD([CY Orders]) = WINDOW_MAX(COUNTD([CY Orders]))\r\nTHEN COUNTD([CY Orders])\r\nELSEIF COUNTD([CY Orders]) = WINDOW_MIN(COUNTD([CY Orders]))\r\nTHEN COUNTD([CY Orders])\r\nEND"
    },
    {
      "name": "PY Quantity",
      "datatype": "integer",
      "role": "measure",
      "formula": "IF YEAR([Order Date]) = [Parameters].[Select Year]-1 THEN [Quantity]\r\nEND"
    },
    {
      "name": "PY Profit",
      "datatype": "real",
      "role": "measure",
      "formula": "IF YEAR([Order Date]) = [Parameters].[Select Year]-1 THEN [Profit]\r\nEND"
    },
    {
      "name": "PY Orders",
      "datatype": "string",
      "role": "dimension",
      "formula": "IF YEAR([Order Date]) = [Parameters].[Select Year]-1 THEN [Order ID]\r\nEND"
    }
  ],
