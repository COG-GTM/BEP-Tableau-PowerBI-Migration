              <properties context="">
                <relation connection="hyper.budget" name="FY Headcount Budget" table="[Extract].[FY Headcount Budget]" type="table">
                  <columns>
                    <column datatype="string" name="division" ordinal="0" />
                    <column datatype="string" name="business_unit" ordinal="1" />
                    <column datatype="string" name="fiscal_year" ordinal="2" />
                    <column datatype="string" name="fiscal_quarter" ordinal="3" />
                    <column datatype="integer" name="headcount_budget" ordinal="4" />
                    <column datatype="integer" name="labor_budget_usd" ordinal="5" />
                  </columns>
                </relation>
              </properties>
            </object>
          </objects>
          <relationships />
        </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
      </connection>
      <column name="[division]" datatype="string" role="dimension" type="nominal" />
      <column name="[business_unit]" datatype="string" role="dimension" type="nominal" />
      <column name="[fiscal_year]" datatype="string" role="dimension" type="nominal" />
      <column name="[fiscal_quarter]" datatype="string" role="dimension" type="nominal" />
      <column name="[headcount_budget]" datatype="integer" role="measure" type="quantitative" />
      <column name="[labor_budget_usd]" datatype="integer" role="measure" type="quantitative" />
    </datasource>
    <datasource hasconnection="false" inline="true" name="Parameters" version="18.1">
      <aliases enabled="yes" />
      <column caption="View As" datatype="string" name="[View As]" param-domain-type="list" role="measure" type="nominal" value="&quot;exec@gdit-demo.example&quot;">
        <calculation class="tableau" formula="&quot;exec@gdit-demo.example&quot;" />
        <members>
          <member value="&quot;exec@gdit-demo.example&quot;" />
          <member value="&quot;defense.lead@gdit-demo.example&quot;" />
          <member value="&quot;hr.analyst@gdit-demo.example&quot;" />
          <member value="&quot;intel.lead@gdit-demo.example&quot;" />
        </members>
