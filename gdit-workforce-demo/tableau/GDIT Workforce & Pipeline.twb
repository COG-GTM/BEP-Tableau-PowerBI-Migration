      <column name="[worker_id]" datatype="string" role="dimension" type="nominal" />
      <column name="[first_name]" datatype="string" role="dimension" type="nominal" />
      <column name="[last_name]" datatype="string" role="dimension" type="nominal" />
      <column name="[gender]" datatype="string" role="dimension" type="nominal" />
      <column name="[birthdate]" datatype="date" role="dimension" type="ordinal" />
      <column name="[education_level]" datatype="string" role="dimension" type="nominal" />
      <column name="[hire_date]" datatype="date" role="dimension" type="ordinal" />
      <column name="[term_date]" datatype="date" role="dimension" type="ordinal" />
      <column name="[term_type]" datatype="string" role="dimension" type="nominal" />
      <column name="[division]" datatype="string" role="dimension" type="nominal" />
      <column name="[business_unit]" datatype="string" role="dimension" type="nominal" />
      <column name="[cost_center]" datatype="string" role="dimension" type="nominal" />
      <column name="[location_state]" datatype="string" role="dimension" type="nominal" semantic-role="[State].[Name]" />
      <column name="[location_city]" datatype="string" role="dimension" type="nominal" />
      <column name="[remote_flag]" datatype="boolean" role="dimension" type="nominal" />
      <column name="[job_family]" datatype="string" role="dimension" type="nominal" />
      <column name="[job_title]" datatype="string" role="dimension" type="nominal" />
      <column name="[job_level]" datatype="integer" role="measure" type="quantitative" />
      <column name="[manager_id]" datatype="string" role="dimension" type="nominal" />
      <column name="[clearance_level]" datatype="string" role="dimension" type="nominal" />
      <column name="[base_salary]" datatype="real" role="measure" type="quantitative" />
      <column name="[performance_rating]" datatype="integer" role="measure" type="quantitative" />
      <column name="[last_updated]" datatype="datetime" role="dimension" type="ordinal" />
      <column name="[event_id]" datatype="string" role="dimension" type="nominal" />
      <column name="[worker_id (worker_events)]" datatype="string" role="dimension" type="nominal" />
      <column name="[event_date]" datatype="date" role="dimension" type="ordinal" />
      <column name="[event_type]" datatype="string" role="dimension" type="nominal" />
      <column name="[from_value]" datatype="string" role="dimension" type="nominal" />
      <column name="[to_value]" datatype="string" role="dimension" type="nominal" />
      <column name="[completion_id]" datatype="string" role="dimension" type="nominal" />
      <column name="[worker_id (training_completions)]" datatype="string" role="dimension" type="nominal" />
      <column name="[course_code]" datatype="string" role="dimension" type="nominal" />
      <column name="[assigned_date]" datatype="date" role="dimension" type="ordinal" />
      <column name="[due_date]" datatype="date" role="dimension" type="ordinal" />
      <column name="[completed_date]" datatype="date" role="dimension" type="ordinal" />
      <column name="[status]" datatype="string" role="dimension" type="nominal" />
      <column name="[score]" datatype="integer" role="measure" type="quantitative" />
      <column name="[course_code (courses)]" datatype="string" role="dimension" type="nominal" />
      <column name="[course_name]" datatype="string" role="dimension" type="nominal" />
      <column name="[category]" datatype="string" role="dimension" type="nominal" />
      <column name="[required]" datatype="boolean" role="dimension" type="nominal" />
      <column name="[recurrence_months]" datatype="integer" role="measure" type="quantitative" />
      <column name="[user_email]" datatype="string" role="dimension" type="nominal" />
      <column name="[division (v_entitlement_expanded)]" datatype="string" role="dimension" type="nominal" />
      <column name="[user_email (v_entitlement_expanded)]" datatype="string" role="dimension" type="nominal">
        <calculation class="tableau" formula="[user_email]" />
      </column>
      <column name="[Entitlement OK]" datatype="boolean" role="dimension" type="nominal">
        <calculation class="tableau" formula="[user_email (v_entitlement_expanded)] = [View As]" comment="replace with USERNAME() when published" />
        <description>replace with USERNAME() when published</description>
      </column>
      <column name="[Is Active]" datatype="boolean" role="dimension" type="nominal">
        <calculation class="tableau" formula="ISNULL([term_date])" />
      </column>
      <column name="[Months Ago Term]" datatype="integer" role="measure" type="quantitative">
        <calculation class="tableau" formula="DATEDIFF('month', [term_date], DATETRUNC('month', TODAY()))" />
      </column>
      <column name="[Latest Window]" datatype="boolean" role="dimension" type="nominal">
        <calculation class="tableau" formula="[Months Ago Term] &gt;= 1 AND [Months Ago Term] &lt;= [Window Months]" />
      </column>
      <column name="[Prior Window]" datatype="boolean" role="dimension" type="nominal">
        <calculation class="tableau" formula="[Months Ago Term] &gt; [Window Months] AND [Months Ago Term] &lt;= 2*[Window Months]" />
      </column>
      <column name="[Voluntary Exit ID]" datatype="string" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF [term_type]='Voluntary' THEN [worker_id] END" />
      </column>
      <column name="[Vol Exits Latest]" datatype="integer" role="measure" type="quantitative">
        <calculation class="tableau" formula="COUNTD(IF [Latest Window] THEN [Voluntary Exit ID] END)" />
      </column>
      <column name="[Vol Exits Prior]" datatype="integer" role="measure" type="quantitative">
        <calculation class="tableau" formula="COUNTD(IF [Prior Window] THEN [Voluntary Exit ID] END)" />
      </column>
      <column name="[Attrition Ratio]" datatype="real" role="measure" type="quantitative">
        <calculation class="tableau" formula="[Vol Exits Latest] / [Vol Exits Prior]" />
      </column>
      <column name="[Headcount]" datatype="integer" role="measure" type="quantitative">
        <calculation class="tableau" formula="COUNTD(IF [Is Active] THEN [worker_id] END)" />
      </column>
      <column name="[Headcount at As Of]" datatype="integer" role="measure" type="quantitative">
        <calculation class="tableau" formula="COUNTD(IF [hire_date] &lt;= [As Of Quarter End] AND (ISNULL([term_date]) OR [term_date] &gt; [As Of Quarter End]) THEN [worker_id] END)" />
      </column>
      <column name="[Tenure at Exit (yrs)]" datatype="real" role="measure" type="quantitative">
        <calculation class="tableau" formula="{FIXED [worker_id]: MIN(DATEDIFF('day', [hire_date], [term_date]))} / 365.25" />
      </column>
      <column name="[Division Avg Salary]" datatype="real" role="measure" type="quantitative">
        <calculation class="tableau" formula="{FIXED [division]: AVG([base_salary])}" />
      </column>
      <column name="[Salary vs Division Avg]" datatype="real" role="measure" type="quantitative">
        <calculation class="tableau" formula="AVG([base_salary]) / AVG([Division Avg Salary]) - 1" />
      </column>
      <column name="[Title Exits (INCLUDE)]" datatype="integer" role="measure" type="quantitative">
        <calculation class="tableau" formula="{INCLUDE [job_title]: [Vol Exits Latest]}" />
      </column>
      <column name="[Division Headcount]" datatype="integer" role="measure" type="quantitative">
        <calculation class="tableau" formula="{FIXED [division]: COUNTD(IF [Is Active] THEN [worker_id] END)}" />
      </column>
      <column name="[Vol Exits Monthly]" datatype="integer" role="measure" type="quantitative">
        <calculation class="tableau" formula="COUNTD([Voluntary Exit ID])" />
      </column>
      <column name="[Monthly Vol Exits YoY %]" datatype="real" role="measure" type="quantitative">
        <calculation class="tableau" formula="(SUM([Vol Exits Monthly]) - LOOKUP(SUM([Vol Exits Monthly]), -12)) / ABS(LOOKUP(SUM([Vol Exits Monthly]), -12))">
          <table-calc ordering-type="Rows" />
        </calculation>
      </column>
      <column name="[Trailing 3M Vol Exits]" datatype="integer" role="measure" type="quantitative">
        <calculation class="tableau" formula="WINDOW_SUM(COUNTD([Voluntary Exit ID]), -2, 0)">
          <table-calc ordering-type="Rows" />
        </calculation>
      </column>
      <column name="[Running Vol Exits YTD]" datatype="integer" role="measure" type="quantitative">
        <calculation class="tableau" formula="RUNNING_SUM(COUNTD([Voluntary Exit ID]))">
          <table-calc ordering-type="Rows" restart-at="Year" />
        </calculation>
      </column>
      <column name="[Title Rank]" datatype="integer" role="measure" type="quantitative">
        <calculation class="tableau" formula="RANK(COUNTD(IF [Latest Window] THEN [Voluntary Exit ID] END))">
          <table-calc ordering-type="Rows" />
        </calculation>
      </column>
      <column name="[Overdue Rate]" datatype="real" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IF [status] = 'Overdue' THEN 1 ELSE 0 END) / SUM(IF [status] IN ('Completed', 'Overdue') THEN 1 ELSE 0 END)" />
      </column>
      <column name="[Division Overdue Rate]" datatype="real" role="measure" type="quantitative">
        <calculation class="tableau" formula="{FIXED [division], [category]: SUM(IF [status]='Overdue' THEN 1 ELSE 0 END) / SUM(IF [status] IN ('Completed','Overdue') THEN 1 ELSE 0 END)}" />
      </column>
      <column name="[Fiscal Year]" datatype="string" role="dimension" type="nominal">
        <calculation class="tableau" formula="&quot;FY&quot; + RIGHT(STR(YEAR([As Of Quarter End])),2)" />
      </column>
      <column name="[Fiscal Quarter]" datatype="string" role="dimension" type="nominal">
        <calculation class="tableau" formula="&quot;Q&quot; + STR(DATEPART('quarter',[As Of Quarter End]))" />
      </column>
      <column name="[Budget Variance %]" datatype="real" role="measure" type="quantitative">
        <calculation class="tableau" formula="[Headcount at As Of] / SUM([FY Budget (extract)].[headcount_budget]) - 1" />
      </column>
      <filter class="categorical" column="[Entitlement OK]">
        <groupfilter function="member" level="[Entitlement OK]" member="true" />
      </filter>
      <group name="[Top N Titles]" ui-builtin="set">
        <groupfilter function="top" level="[job_title]" measure="[Vol Exits Latest]" count="[Top N Titles]" direction="top" />
      </group>
    </datasource>
