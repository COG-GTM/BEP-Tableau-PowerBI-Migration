      <column caption="Window Months" datatype="integer" name="[Window Months]" param-domain-type="range" role="measure" type="quantitative" value="3">
        <calculation class="tableau" formula="3" />
        <range granularity="1" max="12" min="1" />
      </column>
      <column caption="Top N Titles" datatype="integer" name="[Top N Titles]" param-domain-type="range" role="measure" type="quantitative" value="10">
        <calculation class="tableau" formula="10" />
        <range granularity="1" max="25" min="5" />
