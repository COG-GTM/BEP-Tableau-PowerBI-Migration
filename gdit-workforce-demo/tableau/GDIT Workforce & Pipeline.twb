              <calculation class="tableau" formula="IF [status]='Open' AND [needed_by] &lt; TODAY() THEN [headcount] ELSE 0 END" />
            </column>
            <column-instance column="[Past Due Open HC]" derivation="User" name="[usr:Past Due Open HC:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <cols>[federated.gdit_pipeline_live].[none:account_name:nk]</cols>
          <rows>[federated.gdit_pipeline_live].[usr:Revenue at Risk:qk] [federated.gdit_pipeline_live].[usr:Past Due Open HC:qk]</rows>
          <panes>
            <pane selection-relaxation-option="selection-relaxation-allow">
              <view />
              <mark class="Bar" />
              <encodings>
                <color column="[federated.gdit_pipeline_live].[none:account_name:nk]" />
                <text column="[federated.gdit_pipeline_live].[usr:Revenue at Risk:qk]" />
              </encodings>
              <axis name="Revenue at Risk" synchronized="false" />
            </pane>
            <pane selection-relaxation-option="selection-relaxation-allow">
              <view />
              <mark class="Circle" />
              <encodings>
                <color column="[federated.gdit_pipeline_live].[none:account_name:nk]" />
                <text column="[federated.gdit_pipeline_live].[usr:Past Due Open HC:qk]" />
              </encodings>
              <axis name="Past Due Open HC" synchronized="false" />
            </pane>
          </panes>
        </view>
      </table>
    </worksheet>
    <worksheet name="Past Due HC by Family x Clearance">
      <table>
        <view>
          <datasources>
            <datasource caption="Pipeline (live)" name="federated.gdit_pipeline_live" />
          </datasources>
          <datasource-dependencies datasource="federated.gdit_pipeline_live">
            <column name="[job_family]" datatype="string" role="dimension" type="nominal" />
            <column-instance column="[job_family]" derivation="None" name="[none:job_family:nk]" pivot="key" type="nominal" />
            <column name="[clearance_required]" datatype="string" role="dimension" type="nominal" />
            <column-instance column="[clearance_required]" derivation="None" name="[none:clearance_required:nk]" pivot="key" type="nominal" />
            <column name="[Past Due Open HC]" datatype="integer" role="measure" type="quantitative">
              <calculation class="tableau" formula="IF [status]='Open' AND [needed_by] &lt; TODAY() THEN [headcount] ELSE 0 END" />
            </column>
            <column-instance column="[Past Due Open HC]" derivation="User" name="[usr:Past Due Open HC:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <cols>[federated.gdit_pipeline_live].[none:job_family:nk] [federated.gdit_pipeline_live].[none:clearance_required:nk]</cols>
          <rows>[federated.gdit_pipeline_live].[usr:Past Due Open HC:qk]</rows>
          <panes>
            <pane selection-relaxation-option="selection-relaxation-allow">
              <view />
              <mark class="Square" />
              <encodings>
                <color column="[federated.gdit_pipeline_live].[none:job_family:nk]" />
                <text column="[federated.gdit_pipeline_live].[usr:Past Due Open HC:qk]" />
              </encodings>
              <axis name="Past Due Open HC" synchronized="true" />
            </pane>
          </panes>
        </view>
      </table>
    </worksheet>
    <worksheet name="Open Requests Detail">
      <table>
        <view>
          <datasources>
            <datasource caption="Pipeline (live)" name="federated.gdit_pipeline_live" />
          </datasources>
          <datasource-dependencies datasource="federated.gdit_pipeline_live">
            <column name="[account_name]" datatype="string" role="dimension" type="nominal" />
            <column-instance column="[account_name]" derivation="None" name="[none:account_name:nk]" pivot="key" type="nominal" />
            <column name="[opp_id]" datatype="string" role="dimension" type="nominal" />
            <column-instance column="[opp_id]" derivation="None" name="[none:opp_id:nk]" pivot="key" type="nominal" />
            <column name="[job_family]" datatype="string" role="dimension" type="nominal" />
            <column-instance column="[job_family]" derivation="None" name="[none:job_family:nk]" pivot="key" type="nominal" />
            <column name="[Past Due Open HC]" datatype="integer" role="measure" type="quantitative">
              <calculation class="tableau" formula="IF [status]='Open' AND [needed_by] &lt; TODAY() THEN [headcount] ELSE 0 END" />
            </column>
            <column-instance column="[Past Due Open HC]" derivation="User" name="[usr:Past Due Open HC:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <filter class="set" column="[Selected Accounts]" />
          <cols>[federated.gdit_pipeline_live].[none:account_name:nk] [federated.gdit_pipeline_live].[none:opp_id:nk] [federated.gdit_pipeline_live].[none:job_family:nk]</cols>
          <rows>[federated.gdit_pipeline_live].[usr:Past Due Open HC:qk]</rows>
          <panes>
            <pane selection-relaxation-option="selection-relaxation-allow">
              <view />
              <mark class="Text" />
              <encodings>
                <color column="[federated.gdit_pipeline_live].[none:account_name:nk]" />
                <text column="[federated.gdit_pipeline_live].[usr:Past Due Open HC:qk]" />
              </encodings>
              <axis name="Past Due Open HC" synchronized="true" />
            </pane>
          </panes>
        </view>
      </table>
    </worksheet>
    <worksheet name="Overdue Rate by BU">
      <table>
        <view>
          <datasources>
            <datasource caption="Workforce (live)" name="federated.gdit_workforce_live" />
          </datasources>
          <datasource-dependencies datasource="federated.gdit_workforce_live">
            <column name="[business_unit]" datatype="string" role="dimension" type="nominal" />
            <column-instance column="[business_unit]" derivation="None" name="[none:business_unit:nk]" pivot="key" type="nominal" />
            <column name="[Overdue Rate]" datatype="real" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM(IF [status] = 'Overdue' THEN 1 ELSE 0 END) / SUM(IF [status] IN ('Completed', 'Overdue') THEN 1 ELSE 0 END)" />
            </column>
            <column-instance column="[Overdue Rate]" derivation="User" name="[usr:Overdue Rate:qk]" pivot="key" type="quantitative" />
            <column name="[Division Overdue Rate]" datatype="real" role="measure" type="quantitative">
              <calculation class="tableau" formula="{FIXED [division], [category]: SUM(IF [status]='Overdue' THEN 1 ELSE 0 END) / SUM(IF [status] IN ('Completed','Overdue') THEN 1 ELSE 0 END)}" />
            </column>
            <column-instance column="[Division Overdue Rate]" derivation="User" name="[usr:Division Overdue Rate:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <filter class="categorical" column="[category]">
            <groupfilter function="union">
              <groupfilter function="member" level="[category]" member="&quot;Security&quot;" />
            </groupfilter>
          </filter>
          <cols>[federated.gdit_workforce_live].[none:business_unit:nk]</cols>
          <rows>[federated.gdit_workforce_live].[usr:Overdue Rate:qk] [federated.gdit_workforce_live].[usr:Division Overdue Rate:qk]</rows>
          <panes>
            <pane selection-relaxation-option="selection-relaxation-allow">
              <view />
              <mark class="Bar" />
              <encodings>
                <color column="[federated.gdit_workforce_live].[none:business_unit:nk]" />
                <text column="[federated.gdit_workforce_live].[usr:Overdue Rate:qk]" />
              </encodings>
              <axis name="Overdue Rate" synchronized="true" />
            </pane>
          </panes>
          <reference-line field="[Division Overdue Rate]" />
        </view>
      </table>
    </worksheet>
    <worksheet name="Overdue by Course Category">
      <table>
        <view>
          <datasources>
            <datasource caption="Workforce (live)" name="federated.gdit_workforce_live" />
          </datasources>
          <datasource-dependencies datasource="federated.gdit_workforce_live">
            <column name="[category]" datatype="string" role="dimension" type="nominal" />
            <column-instance column="[category]" derivation="None" name="[none:category:nk]" pivot="key" type="nominal" />
            <column name="[Overdue Rate]" datatype="real" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM(IF [status] = 'Overdue' THEN 1 ELSE 0 END) / SUM(IF [status] IN ('Completed', 'Overdue') THEN 1 ELSE 0 END)" />
            </column>
            <column-instance column="[Overdue Rate]" derivation="User" name="[usr:Overdue Rate:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <cols>[federated.gdit_workforce_live].[none:category:nk]</cols>
          <rows>[federated.gdit_workforce_live].[usr:Overdue Rate:qk]</rows>
          <panes>
            <pane selection-relaxation-option="selection-relaxation-allow">
              <view />
              <mark class="Bar" />
              <encodings>
                <color column="[federated.gdit_workforce_live].[none:category:nk]" />
                <text column="[federated.gdit_workforce_live].[usr:Overdue Rate:qk]" />
              </encodings>
              <axis name="Overdue Rate" synchronized="true" />
            </pane>
          </panes>
        </view>
      </table>
    </worksheet>
    <worksheet name="Headcount vs Budget">
      <table>
        <view>
          <datasources>
            <datasource caption="Workforce (live)" name="federated.gdit_workforce_live" />
            <datasource caption="FY Budget (extract)" name="federated.gdit_budget_extract" />
          </datasources>
          <datasource-dependencies datasource="federated.gdit_workforce_live">
            <column name="[division]" datatype="string" role="dimension" type="nominal" />
            <column-instance column="[division]" derivation="None" name="[none:division:nk]" pivot="key" type="nominal" />
            <column name="[Headcount at As Of]" datatype="integer" role="measure" type="quantitative">
              <calculation class="tableau" formula="COUNTD(IF [hire_date] &lt;= [As Of Quarter End] AND (ISNULL([term_date]) OR [term_date] &gt; [As Of Quarter End]) THEN [worker_id] END)" />
            </column>
            <column-instance column="[Headcount at As Of]" derivation="User" name="[usr:Headcount at As Of:qk]" pivot="key" type="quantitative" />
            <column name="[Budget Variance %]" datatype="real" role="measure" type="quantitative">
              <calculation class="tableau" formula="[Headcount at As Of] / SUM([FY Budget (extract)].[headcount_budget]) - 1" />
            </column>
            <column-instance column="[Budget Variance %]" derivation="User" name="[usr:Budget Variance %:qk]" pivot="key" type="quantitative" />
            <column name="[Fiscal Year]" datatype="string" role="dimension" type="nominal">
              <calculation class="tableau" formula="&quot;FY&quot; + RIGHT(STR(YEAR([As Of Quarter End])),2)" />
            </column>
            <column-instance column="[Fiscal Year]" derivation="None" name="[none:Fiscal Year:nk]" pivot="key" type="nominal" />
            <column name="[Fiscal Quarter]" datatype="string" role="dimension" type="nominal">
              <calculation class="tableau" formula="&quot;Q&quot; + STR(DATEPART('quarter',[As Of Quarter End]))" />
            </column>
            <column-instance column="[Fiscal Quarter]" derivation="None" name="[none:Fiscal Quarter:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <datasource-dependencies datasource="federated.gdit_budget_extract">
            <column name="[division]" datatype="string" role="dimension" type="nominal" />
            <column-instance column="[division]" derivation="None" name="[none:division:nk]" pivot="key" type="nominal" />
            <column name="[fiscal_year]" datatype="string" role="dimension" type="nominal" />
            <column-instance column="[fiscal_year]" derivation="None" name="[none:fiscal_year:nk]" pivot="key" type="nominal" />
            <column name="[fiscal_quarter]" datatype="string" role="dimension" type="nominal" />
            <column-instance column="[fiscal_quarter]" derivation="None" name="[none:fiscal_quarter:nk]" pivot="key" type="nominal" />
            <column name="[headcount_budget]" datatype="integer" role="measure" type="quantitative" />
            <column-instance column="[headcount_budget]" derivation="User" name="[usr:headcount_budget:qk]" pivot="key" type="quantitative" />
            <column name="[labor_budget_usd]" datatype="integer" role="measure" type="quantitative" />
            <column-instance column="[labor_budget_usd]" derivation="User" name="[usr:labor_budget_usd:qk]" pivot="key" type="quantitative" />
            <link source="[federated.gdit_workforce_live].[division]" target="[federated.gdit_budget_extract].[division]" />
            <link source="[federated.gdit_workforce_live].[Fiscal Year]" target="[federated.gdit_budget_extract].[fiscal_year]" />
            <link source="[federated.gdit_workforce_live].[Fiscal Quarter]" target="[federated.gdit_budget_extract].[fiscal_quarter]" />
          </datasource-dependencies>
          <cols>[federated.gdit_workforce_live].[none:division:nk]</cols>
          <rows>[federated.gdit_workforce_live].[usr:Headcount at As Of:qk] [federated.gdit_workforce_live].[usr:Budget Variance %:qk]</rows>
          <panes>
            <pane selection-relaxation-option="selection-relaxation-allow">
              <view />
              <mark class="Bar" />
              <encodings>
                <color column="[federated.gdit_workforce_live].[usr:Budget Variance %:qk]" />
                <text column="[federated.gdit_workforce_live].[usr:Headcount at As Of:qk]" />
              </encodings>
              <axis name="Headcount at As Of" synchronized="true" />
            </pane>
          </panes>
          <reference-line field="[FY Budget (extract)].[headcount_budget]" />
        </view>
      </table>
    </worksheet>
  </worksheets>
