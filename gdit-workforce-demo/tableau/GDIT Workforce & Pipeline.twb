      <column name="[filled_worker_id]" datatype="string" role="dimension" type="nominal" />
      <column name="[user_email]" datatype="string" role="dimension" type="nominal" />
      <column name="[division (v_entitlement_expanded)]" datatype="string" role="dimension" type="nominal" />
      <column name="[user_email (v_entitlement_expanded)]" datatype="string" role="dimension" type="nominal">
        <calculation class="tableau" formula="[user_email]" />
      </column>
      <column name="[Entitlement OK]" datatype="boolean" role="dimension" type="nominal">
        <calculation class="tableau" formula="[user_email (v_entitlement_expanded)] = [View As]" />
      </column>
      <column name="[Past Due Open HC]" datatype="integer" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF [status]='Open' AND [needed_by] &lt; TODAY() THEN [headcount] ELSE 0 END" />
      </column>
      <column name="[Opp Amount]" datatype="real" role="measure" type="quantitative">
        <calculation class="tableau" formula="{FIXED [opp_id]: MIN([amount])}" />
      </column>
      <column name="[Opp Requested HC]" datatype="integer" role="measure" type="quantitative">
        <calculation class="tableau" formula="{FIXED [opp_id]: SUM([headcount])}" />
      </column>
      <column name="[Opp Past Due HC]" datatype="integer" role="measure" type="quantitative">
        <calculation class="tableau" formula="{FIXED [opp_id]: SUM([Past Due Open HC])}" />
      </column>
      <column name="[Revenue at Risk]" datatype="real" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM({FIXED [opp_id]: MIN([amount]) * SUM([Past Due Open HC]) / SUM([headcount])})" />
      </column>
      <filter class="categorical" column="[Entitlement OK]">
        <groupfilter function="member" level="[Entitlement OK]" member="true" />
      </filter>
      <group name="[Selected Accounts]" ui-builtin="set">
        <groupfilter function="union" level="[account_name]" />
      </group>
    </datasource>
    <datasource caption="FY Budget (extract)" inline="true" name="federated.gdit_budget_extract" version="18.1">
      <connection class="federated">
        <named-connections>
          <named-connection caption="FY Budget" name="hyper.budget">
            <connection class="hyper" dbname="Data/TableauTemp/GDIT-Budget.hyper" />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
          <objects>
