  "measures_map": {
    "[federated.gdit_workforce_live].[tmn:term_date:qk]": "term_date (Month)",
    "[federated.gdit_workforce_live].[yr:term_date:ok]": "term_date (Year)"
  },
  "lead_overrides": {
    "measures": [
      {
        "name": "Headcount",
        "dax": "CALCULATE(DISTINCTCOUNT('workers'[worker_id]), ISBLANK('workers'[term_date]))",
        "formatString": "#,##0"
      },
      {
        "name": "Vol Exits Latest",
        "dax": "VAR WindowMonths = SELECTEDVALUE('Window Months'[Window Months], 3)\nVAR LastFullMonth = EOMONTH(TODAY(), -1)\nRETURN\n    CALCULATE(\n        [Vol Exits Monthly],\n        DATESBETWEEN(\n            'Calendar'[Date],\n            EOMONTH(LastFullMonth, -WindowMonths) + 1,\n            LastFullMonth\n        )\n    )\n",
        "formatString": "#,##0"
      },
      {
        "name": "Vol Exits Prior",
        "dax": "VAR WindowMonths = SELECTEDVALUE('Window Months'[Window Months], 3)\nVAR LastFullMonth = EOMONTH(TODAY(), -1)\nVAR PriorEnd = EOMONTH(LastFullMonth, -WindowMonths)\nVAR PriorStart = EOMONTH(LastFullMonth, -2 * WindowMonths) + 1\nRETURN\n    CALCULATE(\n        [Vol Exits Monthly],\n        DATESBETWEEN('Calendar'[Date], PriorStart, PriorEnd)\n    )\n",
        "formatString": "#,##0"
      },
      {
        "name": "Attrition Ratio",
        "dax": "DIVIDE([Vol Exits Latest], [Vol Exits Prior])",
        "formatString": "0.00x"
      },
      {
        "name": "Headcount at As Of",
        "dax": "VAR AsOfDate = SELECTEDVALUE('As Of Quarter End'[As Of Quarter End], DATE(2026, 9, 30))\nRETURN\n    CALCULATE(\n        DISTINCTCOUNT('workers'[worker_id]),\n        FILTER(\n            'workers',\n            'workers'[hire_date] <= AsOfDate\n                && (ISBLANK('workers'[term_date]) || 'workers'[term_date] > AsOfDate)\n        )\n    )\n",
        "formatString": "#,##0"
      },
      {
        "name": "Tenure at Exit (yrs)",
        "dax": "AVERAGEX(\n    FILTER('workers', NOT ISBLANK('workers'[term_date])),\n    DIVIDE(DATEDIFF('workers'[hire_date], 'workers'[term_date], DAY), 365.25)\n)\n",
        "formatString": "0.0"
      },
      {
        "name": "Division Avg Salary",
        "dax": "CALCULATE(AVERAGE('workers'[base_salary]), ALLEXCEPT('workers', 'workers'[division]))",
        "formatString": "$#,##0"
      },
      {
        "name": "Salary vs Division Avg",
        "dax": "DIVIDE(AVERAGE('workers'[base_salary]) - [Division Avg Salary], [Division Avg Salary])",
        "formatString": "0.0%;-0.0%;-"
      },
      {
        "name": "Title Exits (INCLUDE)",
        "dax": "SUMX(VALUES('workers'[job_title]), [Vol Exits Latest])",
        "formatString": "#,##0"
      },
      {
        "name": "Division Headcount",
        "dax": "CALCULATE([Headcount], ALLEXCEPT('workers', 'workers'[division]))",
        "formatString": "#,##0"
      },
      {
        "name": "Vol Exits Monthly",
        "dax": "CALCULATE(DISTINCTCOUNT('workers'[worker_id]), 'workers'[term_type] = \"Voluntary\")",
        "formatString": "#,##0"
      },
      {
        "name": "Monthly Vol Exits YoY %",
        "dax": "VAR CurrentExits = [Vol Exits Monthly]\nVAR PriorYearExits =\n    CALCULATE([Vol Exits Monthly], DATEADD('Calendar'[Date], -12, MONTH))\nRETURN DIVIDE(CurrentExits - PriorYearExits, PriorYearExits)\n",
        "formatString": "0.0%;-0.0%;-"
      },
      {
        "name": "Trailing 3M Vol Exits",
        "dax": "CALCULATE(\n    [Vol Exits Monthly],\n    DATESINPERIOD('Calendar'[Date], MAX('Calendar'[Date]), -2, MONTH)\n)\n",
        "formatString": "#,##0"
      },
      {
        "name": "Running Vol Exits YTD",
        "dax": "CALCULATE([Vol Exits Monthly], DATESYTD('Calendar'[Date]))",
        "formatString": "#,##0"
      },
      {
        "name": "Title Rank",
        "dax": "RANKX(ALLSELECTED('workers'[job_title]), [Vol Exits Latest], , DESC, DENSE)",
        "formatString": "0"
      },
      {
        "name": "Top N Title Exits",
        "dax": "VAR TopNCount = SELECTEDVALUE('Top N Titles'[Top N Titles], 10)\nVAR TopTitles =\n    TOPN(\n        TopNCount,\n        ALLSELECTED('workers'[job_title]),\n        [Vol Exits Latest], DESC,\n        'workers'[job_title], ASC\n    )\nVAR CurrentTitle = SELECTEDVALUE('workers'[job_title])\nRETURN\n    IF(\n        CONTAINS(TopTitles, 'workers'[job_title], CurrentTitle),\n        [Vol Exits Latest]\n    )\n",
        "formatString": "#,##0"
      },
      {
        "name": "Overdue Rate",
        "dax": "DIVIDE(\n    CALCULATE(\n        COUNTROWS('training_completions'),\n        'training_completions'[status] = \"Overdue\"\n    ),\n    CALCULATE(\n        COUNTROWS('training_completions'),\n        'training_completions'[status] IN {\"Completed\", \"Overdue\"}\n    )\n)\n",
        "formatString": "0.0%;-0.0%;-"
      },
      {
        "name": "Security Overdue Rate",
        "dax": "CALCULATE([Overdue Rate], 'courses'[category] = \"Security\")",
        "formatString": "0.0%;-0.0%;-"
      },
      {
        "name": "Division Overdue Rate",
        "dax": "CALCULATE(\n    [Security Overdue Rate],\n    ALLEXCEPT('workers', 'workers'[division], 'workers'[business_unit])\n)\n",
        "formatString": "0.0%;-0.0%;-"
      },
      {
        "name": "Fiscal Year",
        "dax": "VAR AsOfDate = SELECTEDVALUE('As Of Quarter End'[As Of Quarter End], DATE(2026, 9, 30))\nRETURN \"FY\" & FORMAT(MOD(YEAR(AsOfDate), 100), \"00\")\n",
        "formatString": ""
      },
      {
        "name": "Fiscal Quarter",
        "dax": "VAR AsOfDate = SELECTEDVALUE('As Of Quarter End'[As Of Quarter End], DATE(2026, 9, 30))\nRETURN \"Q\" & FORMAT(ROUNDUP(MONTH(AsOfDate) / 3, 0), \"0\")\n",
        "formatString": ""
      },
      {
        "name": "Budget Variance %",
        "dax": "VAR AsOfDate = SELECTEDVALUE('As Of Quarter End'[As Of Quarter End], DATE(2026, 9, 30))\nVAR YearKey = \"FY\" & FORMAT(MOD(YEAR(AsOfDate), 100), \"00\")\nVAR QuarterKey = \"Q\" & FORMAT(ROUNDUP(MONTH(AsOfDate) / 3, 0), \"0\")\nVAR PeriodKey = YearKey & \"|\" & QuarterKey\nVAR Budget =\n    CALCULATE(\n        SUM('FY Headcount Budget'[headcount_budget]),\n        'Fiscal Period'[Fiscal Period Key] = PeriodKey\n    )\nRETURN DIVIDE([Headcount at As Of] - Budget, Budget)\n",
        "formatString": "0.0%;-0.0%;-"
      },
      {
        "name": "Budget Headcount",
        "dax": "VAR AsOfDate = SELECTEDVALUE('As Of Quarter End'[As Of Quarter End], DATE(2026, 9, 30))\nVAR YearKey = \"FY\" & FORMAT(MOD(YEAR(AsOfDate), 100), \"00\")\nVAR QuarterKey = \"Q\" & FORMAT(ROUNDUP(MONTH(AsOfDate) / 3, 0), \"0\")\nVAR PeriodKey = YearKey & \"|\" & QuarterKey\nRETURN\n    CALCULATE(\n        SUM('FY Headcount Budget'[headcount_budget]),\n        'Fiscal Period'[Fiscal Period Key] = PeriodKey\n    )\n",
        "formatString": "#,##0"
      },
      {
        "name": "Opp Amount",
        "dax": "SUM('opportunities'[amount])",
        "formatString": "$#,##0"
      },
      {
        "name": "Opp Requested HC",
        "dax": "CALCULATE(SUM('staffing_requests'[headcount]), ALLEXCEPT('staffing_requests', 'staffing_requests'[opp_id]))",
        "formatString": "#,##0"
      },
      {
        "name": "Past Due Open HC",
        "dax": "CALCULATE(\n    SUM('staffing_requests'[headcount]),\n    'staffing_requests'[status] = \"Open\",\n    'staffing_requests'[needed_by] < TODAY(),\n    'opportunities'[stage] = \"Won\"\n)\n",
        "formatString": "#,##0"
      },
      {
        "name": "Opp Past Due HC",
        "dax": "[Past Due Open HC]",
        "formatString": "#,##0"
      },
      {
        "name": "Revenue at Risk (Won contracts)",
        "dax": "SUMX(\n    FILTER(\n        'staffing_requests',\n        'staffing_requests'[status] = \"Open\"\n            && 'staffing_requests'[needed_by] < TODAY()\n            && RELATED('opportunities'[stage]) = \"Won\"\n    ),\n    DIVIDE(\n        RELATED('opportunities'[amount]) * [Past Due Open HC],\n        [Opp Requested HC]\n    )\n)\n",
        "formatString": "$#,##0.00"
      }
    ],
    "calculated_columns": [
      {
        "table": "FY Headcount Budget",
        "name": "Fiscal Period Key",
        "dax": "'FY Headcount Budget'[fiscal_year] & \"|\" & 'FY Headcount Budget'[fiscal_quarter]",
        "dataType": "string",
        "formatString": ""
      }
    ],
    "calculated_tables": [
      {
        "name": "Division",
        "dax": "DISTINCT(\n    UNION(\n        SELECTCOLUMNS('workers', \"division\", 'workers'[division]),\n        SELECTCOLUMNS('opportunities', \"division\", 'opportunities'[division]),\n        SELECTCOLUMNS('FY Headcount Budget', \"division\", 'FY Headcount Budget'[division]),\n        SELECTCOLUMNS('v_entitlement_expanded', \"division\", 'v_entitlement_expanded'[division])\n    )\n)",
        "columns": [
          {
            "name": "division",
            "dataType": "string",
            "formatString": ""
          }
        ]
      },
      {
        "name": "Calendar",
        "dax": "VAR Dates = CALENDAR(DATE(2021, 1, 1), TODAY())\nRETURN\n    ADDCOLUMNS(\n        Dates,\n        \"Month Start\", DATE(YEAR([Date]), MONTH([Date]), 1),\n        \"Fiscal Year\", \"FY\" & FORMAT(MOD(YEAR([Date]), 100), \"00\"),\n        \"Fiscal Quarter\", \"Q\" & FORMAT(ROUNDUP(MONTH([Date]) / 3, 0), \"0\"),\n        \"Fiscal Period Key\",\n            \"FY\" & FORMAT(MOD(YEAR([Date]), 100), \"00\")\n                & \"|Q\" & FORMAT(ROUNDUP(MONTH([Date]) / 3, 0), \"0\")\n    )",
        "columns": [
          {
            "name": "Date",
            "dataType": "date",
            "formatString": ""
          },
          {
            "name": "Month Start",
            "dataType": "date",
            "formatString": ""
          },
          {
            "name": "Fiscal Year",
            "dataType": "string",
            "formatString": ""
          },
          {
            "name": "Fiscal Quarter",
            "dataType": "string",
            "formatString": ""
          },
          {
            "name": "Fiscal Period Key",
            "dataType": "string",
            "formatString": ""
          }
        ]
      },
      {
        "name": "Fiscal Period",
        "dax": "DISTINCT(\n    SELECTCOLUMNS(\n        'FY Headcount Budget',\n        \"Fiscal Year\", 'FY Headcount Budget'[fiscal_year],\n        \"Fiscal Quarter\", 'FY Headcount Budget'[fiscal_quarter],\n        \"Fiscal Period Key\", 'FY Headcount Budget'[Fiscal Period Key]\n    )\n)",
        "columns": [
          {
            "name": "Fiscal Year",
            "dataType": "string",
            "formatString": ""
          },
          {
            "name": "Fiscal Quarter",
            "dataType": "string",
            "formatString": ""
          },
          {
            "name": "Fiscal Period Key",
            "dataType": "string",
            "formatString": ""
          }
        ]
      }
    ],
